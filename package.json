{
  "name": "chaupar-onchain",
  "version": "1.0.0",
  "description": "On-chain card prediction game on Conflux eSpace",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat run scripts/deploy-conflux.js --network confluxEspaceTestnet",
